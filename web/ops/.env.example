# All optional; these are the defaults for the Docker Compose stack. A public client, so no secrets here.
VITE_API_BASE_URL=http://localhost:8080
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/smartrail
VITE_OIDC_CLIENT_ID=smartrail-ops-web
# Station displays: seconds between refreshes (default 10).
VITE_DISPLAY_POLL_SECONDS=10
