{
  "uid": "smartrail-overview",
  "title": "SmartRail Overview",
  "tags": ["smartrail"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(http_server_request_duration_seconds_count, deployment_environment)", "refId": "env" },
        "definition": "label_values(http_server_request_duration_seconds_count, deployment_environment)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Request rate (req/s)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (deployment_environment) (rate(http_server_request_duration_seconds_count{deployment_environment=~\"$env\"}[1m]))", "legendFormat": "{{deployment_environment}}" }
      ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Latency p95",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, deployment_environment) (rate(http_server_request_duration_seconds_bucket{deployment_environment=~\"$env\"}[2m])))", "legendFormat": "{{deployment_environment}}" }
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Server errors (5xx req/s)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (deployment_environment) (rate(http_server_request_duration_seconds_count{deployment_environment=~\"$env\", http_response_status_code=~\"5..\"}[1m]))", "legendFormat": "{{deployment_environment}}" }
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Memory (working set)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (deployment_environment) (dotnet_process_memory_working_set_bytes{deployment_environment=~\"$env\"})", "legendFormat": "{{deployment_environment}}" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Reports received (total, by outcome)",
      "description": "Counter smartrail.events.received. Every operator report the API handled: recorded, repeat or a refusal reason.",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (deployment_environment, event_type, outcome) (smartrail_events_received_total{deployment_environment=~\"$env\"})", "legendFormat": "{{deployment_environment}} {{event_type}} {{outcome}}" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Report to visible (average, s)",
      "description": "Histogram smartrail.events.report_to_visible_seconds, average since the API started. NFR-04 target: 30 s from report to passenger screen (the red line).",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 30 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum by (deployment_environment) (smartrail_events_report_to_visible_seconds_sum{deployment_environment=~\"$env\"}) / sum by (deployment_environment) (smartrail_events_report_to_visible_seconds_count{deployment_environment=~\"$env\"})", "legendFormat": "{{deployment_environment}}" }
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "Journeys completed (total)",
      "description": "Counter smartrail.journeys.completed. A journey is completed when an arrival at the final stop is accepted (spec 06).",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (deployment_environment) (smartrail_journeys_completed_total{deployment_environment=~\"$env\"})", "legendFormat": "{{deployment_environment}}" }
      ]
    },
    {
      "id": 5, "type": "logs", "title": "Logs",
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "expr": "{deployment_environment=~\"$env\"}" }
      ]
    },
    {
      "id": 6, "type": "table", "title": "Recent traces",
      "gridPos": { "x": 0, "y": 41, "w": 24, "h": 9 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        { "refId": "A", "queryType": "traceql", "query": "{ resource.deployment.environment =~ \"$env\" }", "limit": 20 }
      ]
    }
  ]
}
